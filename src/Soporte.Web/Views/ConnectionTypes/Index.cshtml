@model IEnumerable<ConnectionType>
@{
    ViewData["Title"] = "Tipos de conexión";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Tipos de conexión</h2>
    <a class="btn btn-primary" asp-action="Create">Nuevo tipo</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Tipo</th>
                <th>Contacto</th>
                <th>Teléfono</th>
                <th>E-mail</th>
                <th>Activo</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold">@item.Name</td>
                <td>@(item.Contact ?? "—")</td>
                <td>@(item.Phone ?? "—")</td>
                <td>@(item.Email ?? "—")</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge text-bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">No</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
