@model ClientConnection
@{
    ViewData["Title"] = "Detalle de conexión";
    var type = Model.ConnectionType;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">@ViewData["Title"]</h2>
        <p class="text-muted mb-0">@Model.TeamSupportClientName · @type.Name</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light fw-semibold">Cliente (TeamSupport)</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.TeamSupportClientId)</dt>
                    <dd class="col-sm-8"><code>@Model.TeamSupportClientId</code></dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.TeamSupportClientName)</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.TeamSupportClientName</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.TeamSupportClientCode)</dt>
                    <dd class="col-sm-8">@(Model.TeamSupportClientCode ?? "—")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.TeamSupportClientRazonSocial)</dt>
                    <dd class="col-sm-8">@(Model.TeamSupportClientRazonSocial ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light fw-semibold">Tipo de conexión</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ConnectionType.Name)</dt>
                    <dd class="col-sm-8">
                        <span class="badge text-bg-primary">@type.Name</span>
                    </dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ConnectionType.Contact)</dt>
                    <dd class="col-sm-8">@(type.Contact ?? "—")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ConnectionType.Phone)</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(type.Phone))
                        {
                            <a href="tel:@type.Phone">@type.Phone</a>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ConnectionType.Email)</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(type.Email))
                        {
                            <a href="mailto:@type.Email">@type.Email</a>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ConnectionType.IsActive)</dt>
                    <dd class="col-sm-8">
                        @if (type.IsActive)
                        {
                            <span class="badge text-bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light fw-semibold">Registro</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Notes)</dt>
                    <dd class="col-sm-10">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd>

                    <dt class="col-sm-2">Registrado</dt>
                    <dd class="col-sm-10">@Model.RegisteredAt.ToLocalTime().ToString("f")</dd>

                    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.RegisteredByUserName)</dt>
                    <dd class="col-sm-10">@(Model.RegisteredByUserName ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
