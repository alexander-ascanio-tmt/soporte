@{
    ViewData["Title"] = "Inicio";
}

<div class="row align-items-center py-5">
    <div class="col-lg-7">
        <h1 class="display-5 fw-bold text-primary">Portal de Conexiones</h1>
        <p class="lead text-muted mt-3">
            Registre conexiones desde TeamSupport y administre los tipos de conexión
            de su organización.
        </p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="d-flex flex-wrap gap-2 mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="ClientConnections" asp-action="Register">
                    Registrar conexión
                </a>
                <a class="btn btn-outline-primary btn-lg" asp-controller="ConnectionTypes" asp-action="Index">
                    Tipos de conexión
                </a>
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login">
                    Iniciar sesión
                </a>
                <a class="btn btn-outline-primary btn-lg" asp-controller="Account" asp-action="Register">
                    Crear cuenta
                </a>
            </div>
        }
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body p-4">
                <h5 class="card-title">Funcionalidades</h5>
                <ul class="mb-0">
                    <li>Acceso con correo y contraseña</li>
                    <li>Lectura de clientes desde <code>teamsupport_db</code></li>
                    <li>Registro de conexiones en <code>soporte_ts_db</code></li>
                    <li>CRUD de tipos de conexión</li>
                </ul>
            </div>
        </div>
    </div>
</div>
