@model IEnumerable<ClientConnection>
@{
    ViewData["Title"] = "Conexiones registradas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Conexiones registradas</h2>
    <a class="btn btn-primary" asp-action="Register">Registrar cliente</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay conexiones registradas todavía.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle table-connections">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>ERP ID</th>
                    <th>Razón social</th>
                    <th>Tipo de conexión</th>
                    <th>Registrado</th>
                    <th>Por</th>
                    <th>Notas</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.TeamSupportClientName</td>
                    <td>@(item.TeamSupportClientCode ?? "—")</td>
                    <td>@(item.TeamSupportClientRazonSocial ?? "—")</td>
                    <td><span class="badge text-bg-primary">@item.ConnectionType.Name</span></td>
                    <td>@item.RegisteredAt.ToLocalTime().ToString("g")</td>
                    <td>@(item.RegisteredByUserName ?? "—")</td>
                    <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
